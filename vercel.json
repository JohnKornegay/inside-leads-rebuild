{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/locations/raleigh",
      "destination": "/locations/raleigh/index.html"
    },
    {
      "source": "/locations/detroit",
      "destination": "/locations/detroit/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/raleigh",
      "destination": "https://www.getinsideleads.com/locations/raleigh",
      "permanent": true
    },
    {
      "source": "/detroit",
      "destination": "https://www.getinsideleads.com/locations/detroit",
      "permanent": true
    },
    {
      "source": "/raleigh.html",
      "destination": "https://www.getinsideleads.com/locations/raleigh",
      "permanent": true
    },
    {
      "source": "/detroit.html",
      "destination": "https://www.getinsideleads.com/locations/detroit",
      "permanent": true
    },
    {
      "source": "/article",
      "destination": "https://www.getinsideleads.com/blog/how-ai-is-transforming-seo",
      "permanent": true
    },
    {
      "source": "/article.html",
      "destination": "https://www.getinsideleads.com/blog/how-ai-is-transforming-seo",
      "permanent": true
    },
    {
      "source": "/blog-local-seo-raleigh",
